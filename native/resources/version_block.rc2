// Shared VERSIONINFO block (.rc2: rc.exe skips non-#define content in .h includes).
// VF2_RC_DESCRIPTION and VF2_RC_FILENAME before including.
VS_VERSION_INFO VERSIONINFO
 FILEVERSION VF2_RC_VERSION
 PRODUCTVERSION VF2_RC_VERSION
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", VF2_RC_DESCRIPTION
      VALUE "FileVersion", VF2_RC_VERSION_TEXT
      VALUE "ProductName", "Virtua Fighter 2 reKOmped"
      VALUE "ProductVersion", VF2_RC_VERSION_TEXT
      VALUE "OriginalFilename", VF2_RC_FILENAME
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
